{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GX10 qualification result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "outcome",
    "model",
    "provenance",
    "components",
    "gates",
    "scores",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["smoke", "standard", "overnight"]},
    "outcome": {"enum": ["QUALIFIED", "NOT_QUALIFIED", "INFRA_ERROR"]},
    "result_validity": {
      "enum": ["VALID", "QUARANTINED", "INFRA_FAILURE", "INCOMPLETE"]
    },
    "profile_decision": {
      "enum": ["MEETS_PROFILE", "DOES_NOT_MEET_PROFILE", "NOT_ASSESSED"]
    },
    "model": {
      "type": "object",
      "properties": {
        "reasoning_policy": {
          "enum": ["off", "native", "effort:low", "effort:medium", "effort:high"]
        },
        "reasoning_cohort": {"type": "string", "minLength": 1},
        "reasoning_policy_selection_mode": {
          "enum": ["configured", "explicit"]
        },
        "benchmark_track": {
          "enum": ["primary-deployment", "controlled-policy"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "direct_probe": {
          "type": "object",
          "required": ["contract", "max_tokens"],
          "properties": {
            "contract": {"const": "gx10-direct-probe-v1"},
            "max_tokens": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "reasoning_policy": {
          "type": "object",
          "required": [
            "contract",
            "requested",
            "effective",
            "source",
            "cohort",
            "serialized_endpoint_controls"
          ],
          "properties": {
            "contract": {"const": "ollama-reasoning-policy-v1"},
            "requested": {
              "enum": ["configured", "off", "native", "effort:low", "effort:medium", "effort:high"]
            },
            "effective": {
              "enum": ["off", "native", "effort:low", "effort:medium", "effort:high"]
            },
            "source": {"enum": ["models.yaml curated policy", "explicit CLI"]},
            "selection_mode": {"enum": ["configured", "explicit"]},
            "benchmark_track": {
              "enum": ["primary-deployment", "controlled-policy"]
            },
            "cohort": {"type": "string", "minLength": 1},
            "serialized_endpoint_controls": {
              "type": "object",
              "required": ["openai_chat_completions", "ollama_native_chat"],
              "properties": {
                "openai_chat_completions": {"type": "object"},
                "ollama_native_chat": {"type": "object"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "direct": {
          "type": "object",
          "properties": {
            "contract": {"const": "gx10-direct-probe-v1"},
            "max_tokens": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "required": ["passed", "failures"],
      "properties": {
        "passed": {"type": "boolean"},
        "failures": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "scores": {"type": "object"},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "qualification_generation": {"const": "gx10-qualification-v4"}
            },
            "required": ["qualification_generation"]
          }
        }
      },
      "then": {
        "properties": {
          "model": {"required": ["reasoning_policy", "reasoning_cohort"]},
          "provenance": {"required": ["reasoning_policy"]}
        }
      }
    }
  ]
}
