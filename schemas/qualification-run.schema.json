{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GX10 qualification result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "outcome",
    "model",
    "provenance",
    "components",
    "gates",
    "scores",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["smoke", "standard", "overnight"]},
    "outcome": {"enum": ["QUALIFIED", "NOT_QUALIFIED", "INFRA_ERROR"]},
    "result_validity": {
      "enum": ["VALID", "QUARANTINED", "INFRA_FAILURE", "INCOMPLETE"]
    },
    "profile_decision": {
      "enum": ["MEETS_PROFILE", "DOES_NOT_MEET_PROFILE", "NOT_ASSESSED"]
    },
    "model": {
      "type": "object",
      "properties": {
        "runtime": {"enum": ["ollama", "ds4", "vllm"]},
        "runtime_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime_version": {"type": "string", "minLength": 1},
        "runtime_digest_kind": {"type": ["string", "null"]},
        "context_length": {"type": "integer", "minimum": 1},
        "endpoint_api_mode": {"type": ["string", "null"]},
        "capabilities": {"type": ["object", "null"]},
        "deployment_artifacts": {"type": ["object", "null"]},
        "serving_configuration": {"type": ["object", "null"]},
        "reasoning_control_profile": {"type": ["string", "null"]},
        "reasoning_policy": {
          "enum": ["off", "native", "effort:low", "effort:medium", "effort:high"]
        },
        "reasoning_cohort": {"type": "string", "minLength": 1},
        "reasoning_policy_selection_mode": {
          "enum": ["configured", "explicit"]
        },
        "benchmark_track": {
          "enum": ["primary-deployment", "controlled-policy"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "direct_probe": {
          "type": "object",
          "required": ["contract", "max_tokens"],
          "properties": {
            "contract": {"const": "gx10-direct-probe-v1"},
            "max_tokens": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "reasoning_policy": {
          "type": "object",
          "required": [
            "contract",
            "requested",
            "effective",
            "source",
            "cohort",
            "serialized_endpoint_controls"
          ],
          "properties": {
            "contract": {
              "enum": [
                "ollama-reasoning-policy-v1",
                "openai-reasoning-policy-v1",
                "vllm-chat-template-reasoning-policy-v1"
              ]
            },
            "requested": {
              "enum": ["configured", "off", "native", "effort:low", "effort:medium", "effort:high"]
            },
            "effective": {
              "enum": ["off", "native", "effort:low", "effort:medium", "effort:high"]
            },
            "source": {"enum": ["models.yaml curated policy", "explicit CLI"]},
            "selection_mode": {"enum": ["configured", "explicit"]},
            "benchmark_track": {
              "enum": ["primary-deployment", "controlled-policy"]
            },
            "cohort": {"type": "string", "minLength": 1},
            "serialized_endpoint_controls": {
              "type": "object",
              "required": ["openai_chat_completions"],
              "properties": {
                "openai_chat_completions": {"type": "object"},
                "ollama_native_chat": {"type": "object"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "direct": {
          "type": "object",
          "properties": {
            "contract": {"const": "gx10-direct-probe-v1"},
            "max_tokens": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "required": ["passed", "failures"],
      "properties": {
        "passed": {"type": "boolean"},
        "failures": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "scores": {"type": "object"},
    "artifacts": {"type": "object"}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "qualification_generation": {
                "enum": ["gx10-qualification-v4", "gx10-qualification-v5"]
              }
            },
            "required": ["qualification_generation"]
          }
        }
      },
      "then": {
        "properties": {
          "model": {"required": ["reasoning_policy", "reasoning_cohort"]},
          "provenance": {"required": ["reasoning_policy"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "model": {
            "properties": {"runtime": {"const": "ds4"}},
            "required": ["runtime"]
          }
        },
        "required": ["model"]
      },
      "then": {
        "properties": {
          "model": {
            "required": [
              "runtime_digest",
              "runtime_version",
              "context_length",
              "endpoint_api_mode",
              "capabilities",
              "deployment_artifacts"
            ],
            "properties": {
              "endpoint_api_mode": {"const": "openai-chat-completions"},
              "capabilities": {
                "type": "object",
                "required": ["streaming", "tool_calls"],
                "properties": {
                  "streaming": {"const": true},
                  "tool_calls": {"const": true}
                },
                "additionalProperties": true
              },
              "deployment_artifacts": {
                "type": "object",
                "required": [
                  "base_gguf_sha256",
                  "dspark_drafter_sha256",
                  "dspark_enabled"
                ],
                "properties": {
                  "base_gguf_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "dspark_drafter_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "dspark_enabled": {"const": true}
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model": {
            "properties": {"runtime": {"const": "vllm"}},
            "required": ["runtime"]
          }
        },
        "required": ["model"]
      },
      "then": {
        "properties": {
          "model": {
            "required": [
              "runtime_digest",
              "runtime_digest_kind",
              "runtime_version",
              "context_length",
              "endpoint_api_mode",
              "capabilities",
              "deployment_artifacts",
              "serving_configuration",
              "reasoning_control_profile"
            ],
            "properties": {
              "runtime_digest_kind": {
                "const": "vllm-deployment-provenance"
              },
              "endpoint_api_mode": {"const": "openai-chat-completions"},
              "reasoning_control_profile": {
                "const": "qwen-enable-thinking-v1"
              },
              "capabilities": {
                "type": "object",
                "required": ["streaming", "tool_calls"],
                "properties": {
                  "streaming": {"const": true},
                  "tool_calls": {"const": true}
                },
                "additionalProperties": true
              },
              "deployment_artifacts": {
                "type": "object",
                "required": [
                  "provenance_contract",
                  "checkpoint",
                  "checkpoint_revision",
                  "serving_implementation",
                  "serving_revision"
                ],
                "properties": {
                  "provenance_contract": {
                    "const": "vllm-deployment-provenance-v1"
                  },
                  "checkpoint": {"type": "string", "minLength": 1},
                  "checkpoint_revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "serving_implementation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "serving_revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{7,40}$"
                  },
                  "serving_revision_full": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                },
                "additionalProperties": false
              },
              "serving_configuration": {
                "type": "object",
                "required": [
                  "gpu_memory_utilization",
                  "max_num_seqs",
                  "mtp_speculative_tokens",
                  "prefix_caching",
                  "exact_topk",
                  "prewarm"
                ],
                "properties": {
                  "gpu_memory_utilization": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "max_num_seqs": {"type": "integer", "minimum": 1},
                  "mtp_speculative_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "prefix_caching": {"type": "boolean"},
                  "exact_topk": {"type": "boolean"},
                  "prewarm": {"type": "boolean"},
                  "kv_cache_dtype": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  ]
}
